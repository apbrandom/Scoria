[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/menu/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.07, 0.1, 1)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Root" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Center/Root"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
theme_override_colors/font_color = Color(1, 1, 1, 1)
horizontal_alignment = 1
text = "WINGS"

[node name="MainButtons" type="VBoxContainer" parent="Center/Root"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Play" type="Button" parent="Center/Root/MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(260, 48)
text = "Играть"

[node name="Exit" type="Button" parent="Center/Root/MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(260, 48)
text = "Выход"

[node name="DevButton" type="Button" parent="Center/Root/MainButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(260, 48)
text = "Разработка"

[node name="ModeButtons" type="VBoxContainer" parent="Center/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="Single" type="Button" parent="Center/Root/ModeButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Один игрок"

[node name="LocalTwo" type="Button" parent="Center/Root/ModeButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Два игрока (один экран)"

[node name="Network" type="Button" parent="Center/Root/ModeButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "По сети"

[node name="Back" type="Button" parent="Center/Root/ModeButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Назад"

[node name="NetButtons" type="VBoxContainer" parent="Center/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="Hint" type="Label" parent="Center/Root/NetButtons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
horizontal_alignment = 1
text = "Один игрок в окне создаёт игру, второй — присоединяется"
autowrap_mode = 2
custom_minimum_size = Vector2(300, 0)

[node name="Host" type="Button" parent="Center/Root/NetButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Создать игру (хост)"

[node name="Join" type="Button" parent="Center/Root/NetButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Присоединиться"

[node name="Back" type="Button" parent="Center/Root/NetButtons"]
layout_mode = 2
custom_minimum_size = Vector2(300, 48)
text = "Назад"

[node name="DevButtons" type="VBoxContainer" parent="Center/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
