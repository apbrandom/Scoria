## Глобальные правила матча — единственный autoload проекта (см. architecture §5).
##
## Это те самые пункты меню Options оригинала (гравитация, сопротивление воздуха,
## прочность кораблей, скорость перезарядки, фраги до победы), которым нужно быть
## глобальными и настраиваемыми в рантайме, а движку негде их держать. Числа
## отдельных кораблей/оружия сюда НЕ кладём — они в .tres (см. ship_data.gd,
## weapon_data.gd); состояние матча (счёт, чей уровень) — в будущем MatchManager,
## у него жизненный цикл матча, а не всей игры.
##
## ВАЖНО: физические поля — это МНОЖИТЕЛИ поверх базовых значений, и все они по
## умолчанию нейтральны (1.0). То есть свежий проект без единой правки ведёт себя
## ровно так, будто GameRules нет: gravity_scale=1.0 не меняет гравитацию,
## air_resistance_scale=1.0 не меняет linear_damp и т.д. Меню Options позже просто
## двигает эти множители — код кораблей/оружия трогать не нужно.
##
## Где каждое поле применяется (grep по имени, если что-то поедет):
##   gravity_scale        -> Ship.apply_rules()  : RigidBody2D.gravity_scale
##   air_resistance_scale -> Ship.apply_rules()  : linear_damp = data.linear_damp * это
##   ship_strength        -> Ship.take_damage()  : весь входящий урон делится на это
##   reload_time_scale    -> Ship._physics_process(): кулдаун = reload_time * это
extends Node

# --- Физика: множители поверх ShipData/ProjectSettings, 1.0 = «как задано» ---

## Множитель к гравитации корабля (× ProjectSettings physics/2d/default_gravity).
## >1 — тяжелее падать, <1 — «луннее». Базовая гравитация — в project.godot, тут
## только игровой множитель поверх неё.
var gravity_scale: float = 1.0

## Множитель к сопротивлению воздуха (× ShipData.linear_damp). >1 — управление
## «стеклянней», скорость гасится быстрее; <1 — инертнее, дольше по инерции.
var air_resistance_scale: float = 1.0

## Прочность кораблей: ВЕСЬ входящий урон (столкновения и оружие) делится на это.
## >1 — корабли крепче (меню Options «Ship strength» оригинала), <1 — хрупче.
var ship_strength: float = 1.0

## Множитель к времени перезарядки оружия (× WeaponData.reload_time). >1 — реже
## стрельба, <1 — чаще. Общий для всех стволов, поверх числа конкретного оружия.
var reload_time_scale: float = 1.0

# --- Матч ---

## Сколько фрагов до конца уровня. Читает MatchManager (scripts/match/match_manager.gd)
## как условие победы: score >= kills_per_level.
var kills_per_level: int = 10

## Сколько кораблей (локальных игроков с клавиатуры) поднимает level.gd:
## 1 — сольный полёт без противника, 2 — хотсит-дезматч на одном экране
## (P1/P2). Меню (scenes/menu/main_menu.gd) выставляет это ПЕРЕД
## change_scene_to_file(level.tscn). Сетевой режим (net_playground.tscn) это
## поле не читает — там свой, отдельный от хотсита спавн (2 корабля всегда,
## один локальный + один по сети).
var player_count: int = 2

## Открыть level.tscn с рельефом из SandLevelGen (процедурный ландшафт —
## земля/песок/вода, осевший ОДИН РАЗ при генерации через настоящую SandSim,
## не живая симуляция в кадре полёта — notes/terrain_research.md, "статичный
## старт") вместо обычной статичной пары levels/test/visual+mask.png. Меню
## выставляет это ПЕРЕД change_scene_to_file(level.tscn), тот же паттерн, что
## player_count. Другие пункты меню ("Один игрок"/"Два игрока") обязаны
## сбрасывать флаг в false — иначе выбор "Открытый ландшафт" один раз протёк
## бы во все последующие заходы в level.tscn за эту сессию игры.
var use_sand_level: bool = false

## Какую роль занять в net_playground.gd: "auto" (гонка за bind порта — как
## было раньше, годится для .command-файла/прямого запуска сцены в обход
## меню), "host" или "join" (форс, ставит меню кнопками «Создать игру»/
## «Присоединиться» — заказчик явно попросил ВИДЕТЬ и ВЫБИРАТЬ роль, а не
## угадывать её гонкой). net_playground.gd читает это, только если не заданы
## явные --host/--join=<ip> из командной строки (те приоритетнее — межмашинный
## сценарий, см. шапку net_playground.gd); "join" из меню всегда бьёт в
## 127.0.0.1 (то же локальное тестирование в двух окнах, для другого адреса —
## по-прежнему флаг командной строки).
var net_forced_role: String = "auto"

# --- Детали визуала: флаги на будущее (фон, вода, снег) ---

## Включать параллакс-фон уровня. Узла фона пока нет — флаг зарезервирован.
var parallax_enabled: bool = true


## Сбросить все правила к нейтральным значениям по умолчанию. Пригодится тестам
## (чтобы один тест не «протёк» настройками в другой) и рестарту матча.
func reset() -> void:
	gravity_scale = 1.0
	air_resistance_scale = 1.0
	ship_strength = 1.0
	reload_time_scale = 1.0
	kills_per_level = 10
	player_count = 2
	use_sand_level = false
	net_forced_role = "auto"
	parallax_enabled = true
