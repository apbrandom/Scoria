## Настройки бота (AIInput) — все числа поведения здесь, а не в коде (CLAUDE.md).
##
## Отсюда же делается «сложность»: слабый бот — это не другой алгоритм, а другие
## числа (реже решает, шире дрожание прицела, позже замечает землю). Поэтому
## файлов-настроек может быть несколько (`data/ai/*.tres`), а код — один.
##
## Данные: data/ai/default.tres. Потребитель — scripts/input/ai_input.gd.
class_name AISettings
extends Resource

@export_group("Выживание")
## Ниже этой высоты над рельефом бот бросает бой и уходит вверх, px. Главная
## причина смерти в игре с гравитацией — земля, а не противник.
@export_range(20.0, 600.0, 5.0, "suffix:px") var danger_altitude: float = 130.0
## Выше этой высоты бот перестаёт тянуть вверх и возвращается к бою, px.
## Обязан быть заметно больше danger_altitude: без этого зазора бот будет
## дёргаться на границе, включая и выключая тягу каждый кадр.
@export_range(30.0, 900.0, 5.0, "suffix:px") var safe_altitude: float = 260.0
## За сколько секунд до столкновения с землёй считать положение аварийным.
## Работает по текущей скорости снижения — на быстром падении бот начнёт
## выправляться раньше, чем формально опустится ниже danger_altitude.
@export_range(0.1, 5.0, 0.1, "suffix:с") var impact_lookahead: float = 1.2
## Шаг замера расстояния до земли, px. Мельче — точнее и дороже; крупнее
## danger_altitude/4 бот начнёт «не замечать» тонкие выступы.
@export_range(2.0, 32.0, 1.0, "suffix:px") var ground_probe_step: float = 8.0
## Насколько глубоко щупать землю под собой, px. Дальше уже не важно — там
## всё равно безопасно.
@export_range(100.0, 2000.0, 10.0, "suffix:px") var ground_probe_depth: float = 700.0

@export_group("Бой")
## Дальше этого расстояния бот не стреляет, px. Не про дальность оружия, а про
## осмысленность: в упреждение на большой дистанции всё равно не попасть.
@export_range(100.0, 3000.0, 10.0, "suffix:px") var fire_range: float = 900.0
## Допустимая ошибка прицела для выстрела, радианы. Шире — бот мажет и сорит
## снарядами, уже — почти не стреляет, потому что нос всё время «почти» на цели.
@export_range(0.01, 1.0, 0.01, "suffix:рад") var fire_cone: float = 0.14
## Разброс прицела, радианы. Ноль — бот стреляет идеально и играть с ним скучно
## (и он же перестаёт быть похож на живого противника в замерах баланса).
@export_range(0.0, 0.5, 0.01, "suffix:рад") var aim_jitter: float = 0.05
## Сколько шагов уточнять время полёта снаряда. Для прямой трассы хватает
## одного, для падающей бомбы 3-4 заметно точнее; больше — бессмысленно.
@export_range(1, 8, 1) var lead_iterations: int = 4
## Пускать вторичное оружие (бомбу), только если цель НИЖЕ бота на столько px.
## Бомба падает — стрелять ею вверх бессмысленно.
@export_range(-200.0, 400.0, 5.0, "suffix:px") var bomb_min_height_gain: float = 40.0

@export_group("Сближение")
## Наклон носа от вертикали при сближении, радианы. Тяга направлена туда же,
## куда нос (ship.gd:197), поэтому лететь к противнику = наклониться и жечь.
## Больше — быстрее разгон вбок и меньше подъёмной составляющей (можно
## воткнуться в землю), меньше — бот в основном лезет вверх и еле смещается.
@export_range(0.1, 1.4, 0.05, "suffix:рад") var approach_lean: float = 0.7
## Выше этой горизонтальной скорости бот выравнивает нос вместо дальнейшего
## разгона, px/с. Без этого он проскакивает мимо цели и потом тормозит обратно.
@export_range(20.0, 600.0, 10.0, "suffix:px/с") var approach_speed: float = 130.0

@export_group("Обзор")
## Полный угол обзора носа корабля, градусы (конус ±fov_deg/2 от текущего
## aim_angle). Цель вне конуса бот не видит, даже вплотную по расстоянию —
## считается только направление. 90° — по прямой просьбе заказчика, "пока
## что" (devlog §55): узкий обзор согласован с тем, что нос в этой игре почти
## всегда близко к вертикали (тяга и прицел — один угол, ship.gd:197), поэтому
## цель точно сбоку на той же высоте боту придётся сначала довернуть носом,
## а не он её "боковым зрением" замечает.
@export_range(20.0, 360.0, 5.0, "suffix:°") var fov_deg: float = 90.0
## Дальше этого расстояния бот не различает цель, даже глядя прямо на неё, px.
## Отдельно от fire_range: "заметить" и "осмысленно стрелять" — разные дистанции.
@export_range(100.0, 3000.0, 10.0, "suffix:px") var vision_range: float = 1100.0
## Сколько секунд бот ещё "помнит" и экстраполирует положение цели после
## потери видимости (по последней известной скорости), прежде чем признать её
## потерянной и уйти в патрулирование. 0 — цель теряется мгновенно, как только
## пропала из конуса/дальности/видимости.
@export_range(0.0, 10.0, 0.1, "suffix:с") var memory_time: float = 2.5

@export_group("Патрулирование")
## Ни видимой, ни ещё не забытой цели нет — как часто в поиске выбирается
## новая точка облёта карты, сек.
@export_range(1.0, 20.0, 0.5, "suffix:с") var patrol_change_interval: float = 4.0
## Расстояние до точки патруля по горизонтали, ближе которого она считается
## достигнутой и выбирается новая, px.
@export_range(20.0, 400.0, 10.0, "suffix:px") var patrol_arrive_radius: float = 120.0

@export_group("Реакция")
## Как часто бот пересматривает решение (цель, упреждение, режим), сек. Между
## пересмотрами он доворачивает на уже выбранный угол. Это и «человечность»,
## и защита от дребезга: пересчёт каждый кадр даёт дёрганый нос.
@export_range(0.0, 1.0, 0.01, "suffix:с") var decision_interval: float = 0.08
## Мёртвая зона доворота, радианы: ближе этого к нужному углу нос не крутим.
## Без неё бот бесконечно подруливает туда-сюда на доли градуса.
@export_range(0.0, 0.2, 0.005, "suffix:рад") var turn_deadzone: float = 0.02
