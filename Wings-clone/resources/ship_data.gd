## Характеристики корабля как данные (Resource). Один .tres = один корабль.
##
## Все числа — @export с диапазоном (@export_range), поэтому редактируются мышкой
## в инспекторе Godot: FileSystem -> data/ships/normal.tres -> клик -> справа
## появятся поля с ползунками и подсказками (текст ## над полем). Можно и текстом:
## .tres — обычный текстовый файл, значения видны как есть.
##
## ШПАРГАЛКА ПО ФОРМУЛАМ (пригодится при настройке):
##   ускорение от тяги      = thrust / mass                          (px/с²)
##   ускорение от гравитации = default_gravity * gravity_scale корабля (px/с²,
##       НЕ зависит от массы — тяжёлый и лёгкий корабль падают с одинаковым
##       ускорением, как и в жизни; gravity_scale = 1.0 всегда, это правило
##       матча, а не свойство корабля, см. project.godot 2d/default_gravity)
##   чистый разгон вверх при тяге = thrust/mass − default_gravity
##   потолок скорости падения ≈ default_gravity / linear_damp        (px/с)
##
## Числа взяты за ОРИЕНТИР из оригинала (mechanics.md §3.2), но семантика .SHP-полей
## там гипотетическая и сама по себе неоднозначна, поэтому абсолютные значения
## подобраны в Godot-пространстве под ощущение полёта (сознательное решение —
## не обязательно 1:1 с оригиналом, roadmap.md).
class_name ShipData
extends Resource

@export var display_name: String = "ship"
@export var sprite: Texture2D

@export_group("Physics")
## Масса тела. Больше — медленнее разгон тягой (thrust/mass), но НЕ влияет на
## скорость падения (гравитация не зависит от массы).
@export_range(0.2, 5.0, 0.05) var mass: float = 1.0
## Сила тяги. Ориентир: thrust/mass должно заметно превышать default_gravity
## (400 по умолчанию, project.godot), иначе корабль не сможет набрать высоту.
@export_range(50.0, 5000.0, 10.0, "suffix:px/с²·mass") var thrust: float = 800.0
## Скорость поворота, рад/с (умножьте на 57.3, чтобы получить град/с).
@export_range(0.2, 12.0, 0.1, "suffix:рад/с") var turn_rate: float = 3.5
## Сопротивление воздуха. Выше — быстрее гасится скорость, "стеклянней" управление.
## Потолок скорости падения ≈ default_gravity / linear_damp.
@export_range(0.0, 5.0, 0.05) var linear_damp: float = 0.5
## Радиус круглого коллайдера. Визуал (ship.gd) подстраивается под это значение
## автоматически — можно менять смело, корабль не "вылезет" за коллизию.
@export_range(3.0, 30.0, 0.5, "suffix:px") var collision_radius: float = 7.0

@export_group("Combat")
@export_range(1.0, 1000.0, 1.0) var max_hull: float = 100.0
## Пушек у корабля (1 или 2 в оригинале). Пока не используется — в v0.1 только
## одиночный ствол; задел под спред у двухпушечных кораблей, не в этой версии.
@export_range(1, 2, 1) var gun_count: int = 1
## Насколько корпус проседает в рыхлую землю при ударе: радиус кратера =
## (скорость − порог материала) × этот множитель, px радиуса на px/с превышения.
## 0 — корабль не роет рельеф столкновением. По неразрушаемому камню не выроет
## ничего в любом случае — это решает класс материала, не это число
## (см. TerrainPalette.crash_speed_threshold()/crash_damage(), terrain_materials.md).
@export_range(0.0, 0.5, 0.01) var crash_carve_scale: float = 0.05
