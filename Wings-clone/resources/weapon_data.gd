## Параметры оружия как данные (Resource). Один .tres = один вид оружия.
##
## ВАЖНО: .tres-ресурс общий на всех, кто на него ссылается (если корабль X и
## корабль Y оба используют dumbfire.tres — это ОДИН и тот же объект в памяти).
## Поэтому здесь только НЕИЗМЕННЫЕ параметры. Runtime-состояние (боезапас,
## перезарядка) хранится в Ship (см. ship.gd: _primary_ammo, _primary_cd), а не
## здесь — если писать его в поля ресурса, оно расползётся на все корабли и матчи,
## использующие этот файл.
class_name WeaponData
extends Resource

@export var display_name: String = "weapon"
@export var icon: Texture2D
## Сцена снаряда. В v0.1 оба оружия используют один и тот же projectile.tscn —
## разница только в цифрах ниже (масса, гравитация, разлёт), отдельные сцены
## понадобятся только для качественно другого поведения (Bouncer, Mine, Teleport
## и т.п. из бэклога, см. notes/roadmap.md).
@export var projectile_scene: PackedScene

@export_group("Огонь")
## -1 = бесконечно. Заправка/боезапас — см. notes/roadmap.md.
@export var ammo: int = -1
## Задержка между выстрелами, сек.
@export_range(0.05, 5.0, 0.05, "suffix:с") var reload_time: float = 0.5
## Начальная скорость снаряда ОТНОСИТЕЛЬНО корабля, px/с.
@export_range(50.0, 2000.0, 10.0, "suffix:px/с") var muzzle_speed: float = 400.0
## Доля скорости корабля, добавляемая к снаряду (1.0 = снаряд честно наследует
## движение платформы — так и должно быть физически; 0.0 = скорость всегда
## фиксирована относительно мира, как в аркадах попроще).
@export_range(0.0, 1.0, 0.05) var velocity_inherit: float = 1.0
## Гравитация снаряда: 0 — летит по прямой (пулемётная трасса),
## 1 — падает как обычное тело при default_gravity (баллистика ракеты/бомбы).
@export_range(0.0, 2.0, 0.05) var gravity_scale: float = 0.0
## Через сколько секунд снаряд исчезает сам, если ни во что не попал.
@export_range(0.2, 15.0, 0.1, "suffix:с") var lifetime: float = 3.0
## Масштаб снаряда (визуал + коллайдер) относительно базовой сцены
## (projectile.tscn: радиус коллайдера 2px). Общая сцена на все виды оружия
## (см. projectile_scene выше) иначе давала бы пулемётной пуле и ракете
## ОДИНАКОВЫЙ размер — пуля должна выглядеть маленькой и быстрой, а не
## уменьшенной копией ракеты. Применяется в Projectile._ready() (см.
## projectile.gd) — НЕ через self.scale корневого RigidBody2D (физика каждый
## шаг перезаписывает его global_transform результатом симуляции и сбрасывает
## масштаб обратно на 1.0), а через scale дочерних CollisionShape2D/Visual,
## которые физика не трогает.
@export_range(0.2, 3.0, 0.05) var projectile_scale: float = 1.0

@export_group("Урон")
@export_range(0.0, 200.0, 1.0) var damage: float = 20.0
## Радиус поражения и разрушения рельефа вокруг точки попадания, px.
@export_range(0.0, 100.0, 1.0, "suffix:px") var blast_radius: float = 12.0
## Множитель радиуса разрушения рельефа относительно blast_radius. 0 — не роет
## (например, для лёгкого пулемёта, который не должен выедать пещеру насквозь).
@export_range(0.0, 2.0, 0.05) var terrain_power: float = 1.0

## Флаг из W_SELECT.DAT оригинала — доступность оружия при выборе на базе.
## Не используется, пока нет смены оружия (см. notes/roadmap.md).
@export var selectable: bool = true
