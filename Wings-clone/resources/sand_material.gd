## Материал клеточной симуляции рельефа (falling-sand). Описывает ОДИН тип
## вещества: как он выглядит и как себя ведёт. Числа-настройки — здесь (в .tres,
## data/sand/), не в коде: правило проекта — ничего не хардкодить, дизайнер
## меняет поведение материала без правок SandSim.
##
## Это НЕ TerrainPalette. Та описывает материалы СТАРОЙ попиксельной системы
## (класс пикселя для carve/урона по bitmap). SandSim — отдельный прототип
## клеточной симуляции (см. notes/terrain_research.md → "Решение по физике
## рельефа"), со своей моделью данных: ячейка хранит id материала, а поведение
## (падает/стоит/течёт) выбирается по kind. Слияние двух систем — задача будущей
## интеграции, не этого прототипа.
class_name SandMaterial
extends Resource

## Категория поведения в симуляции. По ней SandSim выбирает правило обновления
## ячейки. EMPTY/SOLID/POWDER — реализованы (база); LIQUID/GAS — заложены как
## следующий шаг (тот же диспетчер, добавляется веткой), пока НЕ реализованы.
##
## ВАЖНО: порядок значений должен совпадать с константами KIND_* в
## scripts/sand/sand_sim.gd — там они продублированы намеренно, чтобы горячий
## цикл симуляции не дёргал class_name SandMaterial (по опыту проекта свежий
## class_name может не резолвиться headless-запуском до пересборки кэша).
enum Kind {
	EMPTY,   ## воздух/пустота — сквозь неё всё падает, сама не движется
	SOLID,   ## неподвижная порода (камень/дерево) — не падает, держит форму
	POWDER,  ## сыпучее (песок/земля) — падает вниз, сползает по диагонали в кучу
	LIQUID,  ## жидкость (вода) — падает, стекает к ближайшему обрыву, оседает
	GAS,     ## газ (дым/пар) — всплывает вверх (ещё не реализовано)
	FIRE,    ## огонь — поджигает горючих соседей, выгорает за burn_life, тушится водой
}

## Числовой id, которым материал хранится в ячейке (SandSim — байт на ячейку).
## ДОЛЖЕН быть стабилен и уникален: ячейки ссылаются на него числом, смена id у
## существующего материала перекрасит/переломает уже собранный рельеф.
## 0 зарезервирован под EMPTY (пустая ячейка) — SandSim.resize() заполняет поле
## нулями = всё пусто.
@export var id: int = 0

## Имя для отладки/HUD (по-русски, как весь проект).
@export var mat_name: String = ""

@export var kind: Kind = Kind.EMPTY

## Цвет ячейки при отрисовке. У EMPTY — прозрачный (alpha 0).
@export var color: Color = Color(0, 0, 0, 0)

## Плотность. Сыпучее тонет в жидкости, если плотнее её (песок/земля сквозь
## воду). Сравниваются только эти два случая; для остального пока не влияет.
@export var density: float = 1.0

## Горит ли материал от соседнего огня (дерево — да, камень/вода — нет). Огонь
## превращает горючую ячейку в FIRE с жизнью = burn_life этого материала.
@export var flammable: bool = false

## Сколько тиков горит. Для горючего материала (дерево) — сколько живёт огонь,
## в который он превратится. Для самого материала FIRE — базовая жизнь язычка
## пламени, поставленного напрямую (кистью), пока не выгорел. Для негорючих — 0.
@export var burn_life: int = 0

## Только для FIRE. Детерминированный шанс за тик, что горючий сосед займётся.
## Управляет СКОРОСТЬЮ распространения (сколько тиков идёт по цепочке горючего
## материала), отдельно от burn_life (сколько горит УЖЕ занявшаяся клетка).
## Меньше значение — огонь ползёт по горючему медленнее и заметнее, а не
## вспыхивает почти сразу по всей связной массе.
@export_range(0.0, 1.0) var ignite_chance: float = 0.5

## Только для LIQUID. Доля тиков, в которые движение ячейки детерминированно
## пропускается (0 = течёт свободно каждый раз, когда может; 1 = никогда не
## движется — фактически твёрдое). Даёт вязкость: не физическую формулу
## текучести, а простой замедлитель — "густая" жидкость откликается на
## доступное движение не сразу, а через раз.
@export_range(0.0, 1.0) var viscosity: float = 0.0

## Только для LIQUID. Доля тиков, в которые боковое движение предпочитает
## СОХРАНИТЬ направление прошлого шага, а не выбирать заново по хешу. Даёт
## инертность — жидкость течёт цельным потоком в одну сторону, а не дёргается
## клетка от клетки в разные стороны на ровном месте.
@export_range(0.0, 1.0) var inertia: float = 0.0

## Действует ли гравитация на ЦЕЛЬНЫЙ СВЯЗНЫЙ КУСОК этого материала (SOLID),
## если он потерял опору снизу — падает как единое целое на 1 клетку за тик,
## пока не обопрётся. НЕ путать с POWDER (тот сыпется зерном, рассыпаясь).
## true — падает целиком (дерево: бревно падает бревном, не рассыпается в
## опилки); false — намертво зафиксирован (камень/база рельефа — как сейчас).
@export var falls: bool = false
