## Параметры базы как данные (Resource). Один .tres = один вид базы.
##
## База в оригинале (notes/mechanics.md §4) — это две механики в одной зоне:
## ремонт корабля и смена оружия кнопками поворота, пока корабль на ней стоит.
## Оба числа настраиваются здесь, а не в коде BaseZone.
##
## Арсенал (weapons) лежит именно на БАЗЕ, а не на корабле: в оригинале оружие
## берут на базе, то есть это её свойство как склада, а не характеристика
## корабля. Заодно это единственное место, где перечень доступного оружия
## задаётся данными — иначе список пришлось бы хардкодить в логике перебора.
##
## ВАЖНО (как и у WeaponData): .tres общий на все базы, которые на него
## ссылаются. Здесь только НЕИЗМЕННЫЕ параметры; runtime-состояние (кто сейчас
## пристыкован, на каком оружии остановился игрок) живёт в BaseZone/Ship.
class_name BaseData
extends Resource

@export var display_name: String = "база"

@export_group("Зона")
## Размер прямоугольной зоны базы, px. Корабль считается «на базе», пока он
## внутри неё и достаточно медленный (см. dock_speed_threshold).
@export var zone_size: Vector2 = Vector2(120.0, 60.0)

## Скорость, ниже которой корабль считается СТОЯЩИМ на базе, px/с. Без этого
## порога база чинила бы на пролёте: корабль, проносящийся сквозь зону на
## полной скорости, получал бы ремонт и терял управление поворотом на те
## несколько кадров, что он внутри. Оригинальное «стоя на базе» — это именно
## посадка, а не касание.
@export_range(0.0, 400.0, 5.0, "suffix:px/с") var dock_speed_threshold: float = 40.0

@export_group("Ремонт")
## Скорость восстановления прочности корпуса, единиц/с. Соотносить с
## ShipData.max_hull: 25/с чинит стандартные 100 прочности за 4 секунды.
@export_range(0.0, 500.0, 1.0, "suffix:/с") var repair_rate: float = 25.0

@export_group("Оружие")
## Что можно взять на этой базе. Перебирается только то, у чего
## WeaponData.selectable == true (флаг из W_SELECT.DAT оригинала).
@export var weapons: Array[WeaponData] = []

## Модуль оси ShipInput.turn, считающийся нажатием при выборе оружия. Ось
## непрерывная (-1..+1), а «следующее оружие» — дискретное событие, поэтому
## нужен порог, по пересечению которого ловится фронт (см. BaseZone).
@export_range(0.05, 1.0, 0.05) var turn_press_threshold: float = 0.5
