## Правила процедурной генерации уровня: ЧТО разрешено разыграть генератору и в
## каких пределах. Не сам уровень и не его seed — именно рамки, внутри которых
## каждый новый уровень отличается от предыдущего, но остаётся играбельным.
##
## Зачем ресурс, а не константы в scripts/level/sand_level_gen.gd: правило
## проекта — игровые числа настраивает дизайнер в .tres, без правок кода
## (CLAUDE.md). До этого все числа генератора (высота поверхности, амплитуда
## холмов, размер озёр, толщина каймы) были константами в теле генератора и
## одинаковыми у КАЖДОГО уровня — отсюда и «уровень всегда один и тот же».
##
## Каждая пара *_min/*_max — диапазон, из которого генератор берёт КОНКРЕТНОЕ
## значение детерминированным RNG по seed уровня (см. SandLevelGen._roll).
## Одинаковый seed -> одинаковый уровень (нужно для будущего сетевого матча:
## хост и клиент обязаны получить один рельеф, roadmap.md).
##
## Группа «Играбельность» — не украшение, а фильтр: сгенерированный уровень
## проверяется этими инвариантами, и если провалил — генератор берёт следующий
## seed (см. SandLevelGen.generate). Иначе случайность рано или поздно выдаст
## уровень без неба, залитый водой или без места под спавн.
class_name LevelGenRules
extends Resource

@export_group("Разрешение")
## Сколько пикселей рельефа приходится на одну клетку симуляции. Больше — крупнее
## зерно и дешевле живой тик, меньше — детальнее рельеф и дороже каждый тик
## (цена измеряется tools/bench_live_sand.tscn). Влияет и на генерацию, и на
## живую физику — это одна и та же сетка.
@export_range(2, 16, 1, "suffix:px") var cell_px: int = 6

@export_group("Поверхность")
## Средняя линия рельефа как доля высоты уровня. 0.55 = поверхность на 55%
## сверху, то есть больше половины экрана — открытое небо (явное требование
## заказчика «много открытого пространства»).
@export_range(0.3, 0.8, 0.01) var surface_base_min: float = 0.50
@export_range(0.3, 0.8, 0.01) var surface_base_max: float = 0.62
## Размах холмов как доля высоты уровня — насколько сильно поверхность гуляет
## вверх-вниз относительно средней линии.
@export_range(0.0, 0.4, 0.01) var surface_amplitude_min: float = 0.08
@export_range(0.0, 0.4, 0.01) var surface_amplitude_max: float = 0.20
## Частота шума профиля: меньше — длинные пологие холмы, больше — частые бугры.
@export_range(0.002, 0.1, 0.001) var surface_frequency_min: float = 0.012
@export_range(0.002, 0.1, 0.001) var surface_frequency_max: float = 0.030
@export_range(1, 6, 1) var surface_octaves: int = 3

@export_group("Дюны песка")
## Порог шума, выше которого верхний слой профиля становится песком, а не землёй.
## Больше порог — реже и мельче песчаные пятна.
@export_range(-0.5, 0.8, 0.01) var dune_threshold_min: float = 0.05
@export_range(-0.5, 0.8, 0.01) var dune_threshold_max: float = 0.35
## На сколько клеток вглубь от поверхности может лежать песок.
@export_range(0, 20, 1) var dune_depth_min: int = 3
@export_range(0, 20, 1) var dune_depth_max: int = 8

@export_group("Озёра")
@export_range(0, 6, 1) var lake_count_min: int = 1
@export_range(0, 6, 1) var lake_count_max: int = 3
## Полуширина озера как доля ширины уровня.
@export_range(0.02, 0.3, 0.01) var lake_half_min: float = 0.07
@export_range(0.02, 0.3, 0.01) var lake_half_max: float = 0.16
## Глубина налива в клетках над самой низкой точкой профиля в окне озера.
@export_range(1, 30, 1) var lake_depth_min: int = 4
@export_range(1, 30, 1) var lake_depth_max: int = 10

@export_group("Границы")
## Толщина нерушимой каменной каймы слева/справа/снизу, в клетках. Верх намеренно
## без каймы — там открытое небо, кораблю положено летать (см. SandLevelGen).
@export_range(1, 20, 1) var border_cells: int = 3

@export_group("Играбельность")
## Минимальная доля ПУСТЫХ клеток на поле. Ниже — уровень «завален» породой,
## летать негде.
@export_range(0.0, 1.0, 0.01) var min_open_sky_frac: float = 0.35
## Максимальная доля клеток воды. Выше — уровень превращается в море.
@export_range(0.0, 1.0, 0.01) var max_water_frac: float = 0.12
## Радиус свободного места (в пикселях рельефа), который обязан найтись под спавн
## корабля. Держать согласованным с тем, чем MatchManager чистит точку спавна.
@export_range(4, 200, 1, "suffix:px") var spawn_clear_radius_px: int = 40
## Насколько высоко минимум обязано начинаться небо: самая ВЫСОКАЯ точка рельефа
## не должна подниматься выше этой доли высоты уровня, иначе шпиль упирается в
## потолок и делит карту пополам.
@export_range(0.0, 1.0, 0.01) var min_sky_headroom_frac: float = 0.20
## Сколько seed'ов перебрать, прежде чем сдаться и взять лучший из отвергнутых.
## Провал ВСЕХ попыток не должен ронять загрузку уровня — лучше чуть менее
## удачный уровень, чем чёрный экран.
@export_range(1, 64, 1) var max_attempts: int = 12

@export_group("Базы")
## Полуширина посадочной площадки базы в клетках. Держать согласованным с
## BaseData.zone_size: площадка должна быть не уже зоны, иначе корабль
## «стыкуется», вися над обрывом.
@export_range(2, 40, 1) var base_half_width_cells: int = 5
## Сколько пустых клеток обязано быть НАД площадкой, чтобы туда можно было
## залететь и сесть, а не только протиснуться.
@export_range(2, 40, 1) var base_headroom_cells: int = 6
## Допустимый перепад высоты поверхности по ширине площадки, в клетках. 0 —
## только идеально ровное место (такого на шумовом рельефе почти не бывает),
## слишком много — база встанет на склоне.
@export_range(0, 10, 1) var base_flat_tolerance_cells: int = 2
## Толщина каменного пласта, вписываемого ПОД базу. Камень carve не берёт
## (TerrainPalette.Cls.INDESTRUCTIBLE), поэтому площадку не выроет бомбой и не
## засыплет живой осыпью SandSim — база остаётся пригодной весь матч.
@export_range(1, 20, 1) var base_platform_depth_cells: int = 3
