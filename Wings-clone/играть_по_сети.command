#!/bin/bash
# Двойной клик — открывает НОВОЕ окно игры (главное меню WINGS), без
# редактора и без F-клавиш. Кликните этот файл ДВАЖДЫ (два раза, каждый раз
# откроется НОВОЕ отдельное окно) — в одном окне жмите «Играть» → «По сети» →
# «Создать игру», во втором — «Играть» → «По сети» → «Присоединиться». Роль
# теперь выбирается руками в меню (см. scenes/menu/main_menu.gd), а не
# автоматически — так удобнее видеть, кто есть кто.
#
# Этот же файл годится и для одиночной/парной игры — двойной клик, дальше
# «Играть» → «Один игрок»/«Два игрока» в открывшемся окне, второе окно не
# нужно.
cd "$(dirname "$0")"
/Applications/Godot.app/Contents/MacOS/Godot --path .
echo ""
echo "Окно игры закрыто. Нажмите Enter, чтобы закрыть это окно терминала."
read
