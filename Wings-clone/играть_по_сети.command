#!/bin/bash
# Двойной клик — открывает окно игры и подключается по сети (127.0.0.1) к
# другому такому же окну. Кликните этот файл ДВАЖДЫ (два раза, каждый раз
# откроется новое окно) — первое окно само станет хостом, второе подключится
# к нему. Роль определяется автоматически, вводить ничего не нужно.
cd "$(dirname "$0")"
/Applications/Godot.app/Contents/MacOS/Godot --path . res://scenes/level/net_playground.tscn
echo ""
echo "Окно игры закрыто. Нажмите Enter, чтобы закрыть это окно терминала."
read
